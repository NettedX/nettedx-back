NETTEDX_APP_NAME=NettedX API
NETTEDX_APP_ENV=dev
NETTEDX_DEBUG=true
NETTEDX_API_V1_PREFIX=/v1

NETTEDX_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://nettedx.com

# Docker Uvicorn
NETTEDX_UVICORN_HOST=0.0.0.0
NETTEDX_UVICORN_PORT=8000
NETTEDX_UVICORN_WORKERS=1

# JWT
NETTEDX_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
NETTEDX_JWT_ALGORITHM=HS256
NETTEDX_JWT_ACCESS_TTL_SECONDS=300
NETTEDX_JWT_REFRESH_TTL_SECONDS=604800

# SIWE
NETTEDX_SIWE_DOMAIN=localhost:5173
NETTEDX_SIWE_URI=http://localhost:5173
NETTEDX_SIWE_STATEMENT=Sign in to NettedX.
NETTEDX_SIWE_ALLOWED_CHAIN_IDS=   
NETTEDX_SIWE_NONCE_TTL_SECONDS=300  #nonce有效时间为5min

# Blockchain
NETTEDX_BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# 可选：Demo 可留空并使用 Anvil 解锁的第一个账户；部署环境应配置专用 relayer 私钥
NETTEDX_BLOCKCHAIN_RELAYER_PRIVATE_KEY=
NETTEDX_BLOCKCHAIN_TRANSACTION_TIMEOUT_SECONDS=30
NETTEDX_MOCK_USDC_CONTRACT_ADDRESS=
NETTEDX_MOCK_BOND_CONTRACT_ADDRESS=
NETTEDX_SETTLEMENT_CONTRACT_ADDRESS=
NETTEDX_NETTING_CONTRACT_ADDRESS=
NETTEDX_LIQUIDITY_BUFFER_CONTRACT_ADDRESS=
NETTEDX_NETTING_DEPLOYMENT_BLOCK=0   #表示从区块0开始扫描Netting合约部署在哪个区块
NETTEDX_BLOCKCHAIN_EVENT_SCAN_CHUNK_SIZE=2000  #表示每次向节点查询2000个区块的事件，防止一次请求过大的区块范围被 RPC 节点拒绝
NETTEDX_BLOCKCHAIN_EVENT_CONFIRMATIONS=0  #表示只统计至少确认了多少个区块的事件；若为0则表示最新区块中的交易也立即统计
NETTEDX_CASH_TOKEN_DECIMALS=6
NETTEDX_BOND_TOKEN_DECIMALS=0


# Database
NETTEDX_DB_HOST=127.0.0.1
NETTEDX_DB_PORT=3306
NETTEDX_DB_USER=nettedx
NETTEDX_DB_PASSWORD=
NETTEDX_DB_NAME=nettedx
NETTEDX_DB_ECHO=false
